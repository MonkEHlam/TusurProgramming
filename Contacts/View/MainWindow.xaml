<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:vm="clr-namespace:View.ViewModel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="600">

    <Window.DataContext>
        <vm:MainVM />
    </Window.DataContext>

    <DockPanel Margin="15">
        <!-- Кнопки Save и Load прикреплены к правой части окна -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Height="25" Margin="3" Command="{Binding SaveCommand}" FontSize="15" CommandParameter="{Binding Contact}"/>
            <Button Content="Load" Width="75" Height="25" Margin="3" Command="{Binding LoadCommand}" FontSize="15"/>
        </StackPanel>

        <!-- Основной контент (Grid с GroupBox) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Edit Contact -->
            <GroupBox Header="Edit Contact" Grid.Column="0" Margin="10" FontSize="15">
                <StackPanel Margin="10">
                    <Label Content="Name:" Margin="3"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="3"/>
                    <Label Content="Phone Number:" Margin="3"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="3">
                    </TextBox>
                    <Label Content="Email:" Margin="3"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="3">
                    </TextBox>
                </StackPanel>
            </GroupBox>

            <!-- Read Contact -->
            <GroupBox Header="Read Contact" Grid.Column="1" Margin="10" FontSize="15">
                <StackPanel Margin="10">
                    <Label Content="Name:" Margin="3"/>
                    <TextBlock Text="{Binding Name}" Margin="3"/>
                    <Label Content="Phone Number:" Margin="3"/>
                    <TextBlock Text="{Binding Phone}" Margin="3"/>
                    <Label Content="Email:" Margin="3"/>
                    <TextBlock Text="{Binding Email}" Margin="3"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
