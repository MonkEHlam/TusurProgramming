<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:vm="clr-namespace:ViewModel;assembly=ViewModel" xmlns:controls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="MainWindow" Height="358" Width="478" MinWidth="650" MinHeight="450"
        Closing="MainWindow_Closing" Loaded="MainWindow_Loaded">

    <Window.DataContext>
        <vm:MainVM />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="ContactTemplate">
            <StackPanel Orientation="Horizontal" Margin="3">
                <Image Width="40" Height="40" Source="/Static/person.png" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"/>
                    <TextBlock 
                    FontSize="10" 
                    Text="{Binding Phone}"/>
                    <TextBlock 
                    FontSize="10" 
                    Text="{Binding Email}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                    Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="LightPink"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    
    <DockPanel Margin="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Find:" Margin="3" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="3" VerticalAlignment="Center"/>
                </Grid>

                <ListBox x:Name="ContactsListBox" Grid.Row="1" Margin="5"
                         ItemsSource="{Binding Contacts}"
                         SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                         ItemTemplate="{StaticResource ContactTemplate}">
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,8,10,8">
                    <Button Content="Add" Width="80" Height="25" Margin="3"
                            Command="{Binding AddCommand}"/>
                    <Button Content="Edit" Width="80" Height="25" Margin="3"
                            Command="{Binding EditCommand}"
                            IsEnabled="{Binding IsContactSelected}"/>
                    <Button Content="Remove" Width="80" Height="25" Margin="3"
                            Command="{Binding RemoveCommand}"
                            IsEnabled="{Binding IsContactSelected}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2">
                <controls:ContactControl DataContext="{Binding SelectedContact}" />
                <Button Grid.Column="1" Content="Apply" Width="75" Height="25" Margin="8,50,8,8" 
                        HorizontalAlignment="Right" Visibility="{Binding ApplyButtonVisibility}" Command="{Binding ApplyCommand}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
